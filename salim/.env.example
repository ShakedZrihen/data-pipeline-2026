# --- Object storage (Supabase Storage in prod / MinIO locally) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=raw-prices
S3_REGION=us-east-1

# --- Queue (CloudAMQP in prod / RabbitMQ locally) ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=raw-prices

# --- Database (Supabase Postgres in prod / Postgres locally) ---
DATABASE_URL=postgresql+psycopg2://salim:salim@postgres:5432/salim

# --- Crawler ---
# Runs every source registered in crawler.py's CRAWLERS list on this schedule.
CRON_SCHEDULE=0 */6 * * *
# Local scratch dir for in-flight downloads before they're uploaded,
# namespaced per source (<DOWNLOAD_DIR>/<name>/) — no per-source env vars
# needed. Each crawler's checkpoint lives in S3 itself, not on local disk:
# s3://<S3_BUCKET>/<name>_last_run.txt, alongside its s3://<S3_BUCKET>/<name>/ folder.
DOWNLOAD_DIR=/tmp/salim-crawler/downloads
# Per-source url/username/suffixes live in code (CrawlerSpec, in crawler.py) —
# they're effectively public info (gov.il price-transparency law). Only set
# this if a source needs a real secret password beyond what's in its spec:
# CRAWLER_<NAME>_PASSWORD=... (e.g. CRAWLER_YOHANANOF_PASSWORD)

# Initial inclusive start date for Victory. Supported formats:
# YYYYMMDD, YYYYMMDDHHMM, or YYYYMMDDHHMMSS.
# After a successful run, the crawler continues from its saved checkpoint.
CRAWLER_VICTORY_START_DATE=20260801

# --- Loader / enricher ---
# Manufacturer enrichment: the loader itself never calls the LLM; run
# `docker compose run --rm loader-enrich` (or `python enrich.py --backfill`)
# to resolve what the raw field / cache / brand dictionary could not.
ANTHROPIC_API_KEY=
ENRICHER_MODEL=claude-haiku-4-5
# Names per LLM request, and how many failed requests a name survives before
# it is left alone (`enrich.py --reset-attempts` re-opens them).
ENRICHER_BATCH_SIZE=50
ENRICHER_MAX_ATTEMPTS=3
# Messages per DB transaction, and how long to wait for more before flushing.
LOADER_BATCH_SIZE=200
LOADER_BATCH_WAIT_SECONDS=2
# Host port for the local Postgres (change if 5432 is taken on your machine).
POSTGRES_HOST_PORT=5432

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
