# Where the UI sends its API calls.
#
# Leave unset for local development: the Vite dev server proxies /api to
# API_TARGET (default http://localhost:8000), so the browser stays on one origin.
#
# For a deployed build, set this to the API's public URL and add this UI's
# origin to the API's UI_ORIGINS, or the browser will block the responses.
# VITE_API_BASE_URL=https://salim-api.example.com

# Only used by the dev-server proxy. Change it if the API is not on port 8000.
# API_TARGET=http://localhost:8000
